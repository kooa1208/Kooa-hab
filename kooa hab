local Settings = {
    AutoAim = false,
    FOV = 500,
}

local Rage = {
    Rage = false,
    AntiAim = false,
    Orbit = false,
    OrbitSpeed = 10,
    OrbitDistance = 3.5,
    X = 0, Y = -10, Z = 0,
    AntiAimLocked = false,
    AntiAimPos = nil,
}

local SilentAim = { Enabled = false }

-- ============================================
-- TARGET ACQUISITION
-- ============================================
local function get_best_target()
    local cameraLook = Camera.CFrame.LookVector
    local target = nil
    local bestDot = -1

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character and plr.Character:FindFirstChild("Head") and plr.Character:FindFirstChild("HumanoidRootPart") then
            local head = plr.Character.Head
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local toTarget = (head.Position - Camera.CFrame.Position)
                local distance = toTarget.Magnitude
                if distance <= Settings.FOV then
                    local dot = cameraLook.Unit:Dot(toTarget.Unit)
                    if dot > bestDot then
                        local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
                        if onScreen then
                            bestDot = dot
                            target = head
                        end
                    end
                end
            end
        end
    end
    return target
end

-- ============================================
-- AUTO AIM (Camera Direct Override)
-- ============================================
RunService.RenderStepped:Connect(function()
    if Settings.AutoAim then
        local target = get_best_target()
        if target then
            Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, target.Position)
        end
    end
end)

-- ============================================
-- SILENT AIM (Raycast Override)
-- ============================================
task.spawn(function()
    task.wait(3)
    local ok, utility = pcall(function()
        return require(ReplicatedStorage:WaitForChild("Modules", 5):WaitForChild("Utility", 5))
    end)
    if ok and utility then
        local old_ray = utility.Raycast
        utility.Raycast = function(...)
            local args = {...}
            if SilentAim.Enabled then
                local target = get_best_target()
                if target then args[3] = target.Position end
            end
            return old_ray(table.unpack(args))
        end
    end
end)

