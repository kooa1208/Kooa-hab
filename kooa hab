-- ============================================
-- ANTI-AIM / RAGE / ORBIT
-- ============================================
local OrbitAngle = 0

task.spawn(function()
    while task.wait(0.1) do
        if Rage.AntiAim then
            if not Rage.AntiAimLocked then
                local root = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                if root then
                    Rage.AntiAimPos = root.Position + Vector3.new(Rage.X, Rage.Y, Rage.Z)
                    Rage.AntiAimLocked = true
                end
            end
        else
            Rage.AntiAimLocked = false
            Rage.AntiAimPos = nil
        end
    end
end)

RunService.RenderStepped:Connect(function(dt)
    if not LP.Character or not LP.Character:FindFirstChild("HumanoidRootPart") then return end
    local root = LP.Character.HumanoidRootPart

    -- RAGE (Overlap Enemy)
    if Rage.Rage then
        EnableFastWeapon()
        local nearest = nil
        local nd = math.huge
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LP and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                local d = (plr.Character.HumanoidRootPart.Position - root.Position).Magnitude
                if d < nd then nd = d; nearest = plr end
            end
        end
        if nearest then
            root.CFrame = nearest.Character.HumanoidRootPart.CFrame
        end
    end

    -- ORBIT (3.5 studs)
    if Rage.Orbit then
        local nearest = nil
        local nd = math.huge
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LP and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                local d = (plr.Character.HumanoidRootPart.Position - root.Position).Magnitude
                if d < nd then nd = d; nearest = plr end
            end
        end
        if nearest then
            local targetPos = nearest.Character.HumanoidRootPart.Position
            OrbitAngle = OrbitAngle + (Rage.OrbitSpeed * dt * 10)
            local offset = Vector3.new(
                math.cos(OrbitAngle) * Rage.OrbitDistance,
                0,
                math.sin(OrbitAngle) * Rage.OrbitDistance
            )
            root.CFrame = CFrame.new(targetPos + offset)
            root.CFrame = root.CFrame * CFrame.Angles(0, OrbitAngle, 0)
        end
    end

    -- ANTI-AIM (Locked Position)
    if Rage.AntiAim and Rage.AntiAimPos then
        root.CFrame = CFrame.new(Rage.AntiAimPos)
        root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(180), 0)
    end
end)

