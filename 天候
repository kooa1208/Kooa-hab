local currentWeatherType = "none"

local function updateWeatherButtons()
    local buttons = {rainButton, snowButton, noneWeatherButton}
    local types = {"rain", "snow", "none"}
    for i, button in ipairs(buttons) do
        if currentWeatherType == types[i] then
            button.BackgroundColor3 = Color3.fromRGB(55,55,65)
            button.TextColor3 = Color3.fromRGB(255,255,255)
        else
            button.BackgroundColor3 = Color3.fromRGB(35,35,40)
            button.TextColor3 = Color3.fromRGB(150,150,170)
        end
    end
end

rainButton.MouseButton1Click:Connect(function() currentWeatherType = "rain" updateWeatherButtons() createRain() end)
snowButton.MouseButton1Click:Connect(function() currentWeatherType = "snow" updateWeatherButtons() createSnow() end)
noneWeatherButton.MouseButton1Click:Connect(function() currentWeatherType = "none" updateWeatherButtons() clearWeather() end)

rainIntensitySlider.MouseButton1Down:Connect(function(x,y)
    local percent = (x - rainIntensitySlider.AbsolutePosition.X) / rainIntensitySlider.AbsoluteSize.X
    rainSettings.intensity = math.clamp(percent*3,0,3)
    rainIntensityLabel.Text = "RAIN AMOUNT: "..string.format("%.1f",rainSettings.intensity)
    if currentWeatherType == "rain" then createRain() end
end)
rainSizeSlider.MouseButton1Down:Connect(function(x,y)
    local percent = (x - rainSizeSlider.AbsolutePosition.X) / rainSizeSlider.AbsoluteSize.X
    rainSettings.dropSize = math.clamp(0.5+percent*1.5,0.5,2)
    rainSizeLabel.Text = "RAIN SIZE: "..string.format("%.1f",rainSettings.dropSize)
    if currentWeatherType == "rain" then createRain() end
end)
rainSpeedSlider.MouseButton1Down:Connect(function(x,y)
    local percent = (x - rainSpeedSlider.AbsolutePosition.X) / rainSpeedSlider.AbsoluteSize.X
    rainSettings.dropSpeed = math.clamp(0.5+percent*1.5,0.5,2)
    rainSpeedLabel.Text = "RAIN SPEED: "..string.format("%.1f",rainSettings.dropSpeed)
    if currentWeatherType == "rain" then createRain() end
end)
snowIntensitySlider.MouseButton1Down:Connect(function(x,y)
    local percent = (x - snowIntensitySlider.AbsolutePosition.X) / snowIntensitySlider.AbsoluteSize.X
    snowSettings.intensity = math.clamp(percent*3,0,3)
    snowIntensityLabel.Text = "SNOW AMOUNT: "..string.format("%.1f",snowSettings.intensity)
    if currentWeatherType == "snow" then createSnow() end
end)
snowSizeSlider.MouseButton1Down:Connect(function(x,y)
    local percent = (x - snowSizeSlider.AbsolutePosition.X) / snowSizeSlider.AbsoluteSize.X
    snowSettings.flakeSize = math.clamp(0.3+percent*1.2,0.3,1.5)
    snowSizeLabel.Text = "SNOW SIZE: "..string.format("%.1f",snowSettings.flakeSize)
    if currentWeatherType == "snow" then createSnow() end
end)
snowSpeedSlider.MouseButton1Down:Connect(function(x,y)
    local percent = (x - snowSpeedSlider.AbsolutePosition.X) / snowSpeedSlider.AbsoluteSize.X
    snowSettings.fallSpeed = math.clamp(0.5+percent*1.5,0.5,2)
    snowSpeedLabel.Text = "SNOW SPEED: "..string.format("%.1f",snowSettings.fallSpeed)
    if currentWeatherType == "snow" then createSnow() end
end)

brightnessSlider.MouseButton1Down:Connect(function(x,y)
    local value = math.clamp((x - brightnessSlider.AbsolutePosition.X) / brightnessSlider.AbsoluteSize.X * 5, 0, 5)
    brightnessLabel.Text = "BRIGHTNESS: "..string.format("%.1f",value)
    Lighting.Brightness = value
end)
exposureSlider.MouseButton1Down:Connect(function(x,y)
    local value = math.clamp((x - exposureSlider.AbsolutePosition.X) / exposureSlider.AbsoluteSize.X * 10 - 5, -5, 5)
    exposureLabel.Text = "EXPOSURE: "..string.format("%.1f",value)
    Lighting.ExposureCompensation = value
end)
saturationSlider.MouseButton1Down:Connect(function(x,y)
    local value = math.clamp((x - saturationSlider.AbsolutePosition.X) / saturationSlider.AbsoluteSize.X * 2 - 1, -1, 1)
    saturationLabel.Text = "SATURATION: "..string.format("%.1f",value)
    Lighting.ColorCorrectionSaturation = value
end)
contrastSlider.MouseButton1Down:Connect(function(x,y)
    local value = math.clamp((x - contrastSlider.AbsolutePosition.X) / contrastSlider.AbsoluteSize.X * 2 - 1, -1, 1)
    contrastLabel.Text = "CONTRAST: "..string.format("%.1f",value)
    Lighting.ColorCorrectionContrast = value
end)
fogSlider.MouseButton1Down:Connect(function(x,y)
    local value = math.clamp((x - fogSlider.AbsolutePosition.X) / fogSlider.AbsoluteSize.X, 0, 1)
    fogLabel.Text = "FOG DENSITY: "..string.format("%.1f",value)
    Lighting.FogStart = 100 - value*80
    Lighting.FogEnd = 300 - value*200
end)
sunSlider.MouseButton1Down:Connect(function(x,y)
    local value = math.clamp((x - sunSlider.AbsolutePosition.X) / sunSlider.AbsoluteSize.X * 3, 0, 3)
    sunLabel.Text = "SUN INTENSITY: "..string.format("%.1f",value)
    if Lighting:FindFirstChild("SunLight") then
        Lighting.SunLight.Brightness = value
        Lighting.SunLight.Enabled = value > 0
    end
end)
ambientSlider.MouseButton1Down:Connect(function(x,y)
    local value = math.clamp((x - ambientSlider.AbsolutePosition.X) / ambientSlider.AbsoluteSize.X, 0, 1)
    ambientLabel.Text = "AMBIENT WARMTH: "..string.format("%.1f",value)
    Lighting.OutdoorAmbient = Color3.fromRGB(127+(value-0.5)*100,127,127-(value-0.5)*100)
end)

local shadowEnabled = true
shadowButton.MouseButton1Click:Connect(function()
    shadowEnabled = not shadowEnabled
    shadowButton.Text = "SHADOWS: "..(shadowEnabled and "ON" or "OFF")
    Lighting.GlobalShadows = shadowEnabled
end)

local tintButtonMap = {
    {button = noneTintButton, value = "NONE"}, {button = purpleTintButton, value = "PURPLE"},
    {button = greenTintButton, value = "GREEN"}, {button = pinkTintButton, value = "PINK"},
    {button = whiteTintButton, value = "WHITE"}
}
local function updateTintButtons()
    for _, data in ipairs(tintButtonMap) do
        if currentTint == data.value then
            data.button.BackgroundColor3 = Color3.fromRGB(55,55,65)
            data.button.TextColor3 = Color3.fromRGB(255,255,255)
        else
            data.button.BackgroundColor3 = Color3.fromRGB(35,35,40)
            data.button.TextColor3 = Color3.fromRGB(150,150,170)
        end
    end
end
for _, data in ipairs(tintButtonMap) do
    data.button.MouseButton1Click:Connect(function()
        applyTint(data.value)
        updateTintButtons()
    end)
end

resetButton.MouseButton1Click:Connect(function()
    currentWeatherType = "none"
    currentTint = "NONE"
    rainSettings = {intensity=1, dropSize=1, dropSpeed=1}
    snowSettings = {intensity=1, flakeSize=0.5, fallSpeed=1}
    updateWeatherButtons()
    updateTintButtons()
    clearWeather()
    applyTint("NONE")
    Lighting.Brightness = 3
    Lighting.ExposureCompensation = 0
    Lighting.ColorCorrectionSaturation = 0
    Lighting.ColorCorrectionContrast = 0
    Lighting.GlobalShadows = true
    Lighting.OutdoorAmbient = Color3.fromRGB(127,127,127)
    Lighting.FogStart = 100
    Lighting.FogEnd = 300
    if Lighting:FindFirstChild("SunLight") then
        Lighting.SunLight.Brightness = 1
        Lighting.SunLight.Enabled = true
    end
    rainIntensityLabel.Text = "RAIN AMOUNT: 1.0"
    rainSizeLabel.Text = "RAIN SIZE: 1.0"
    rainSpeedLabel.Text = "RAIN SPEED: 1.0"
    snowIntensityLabel.Text = "SNOW AMOUNT: 1.0"
    snowSizeLabel.Text = "SNOW SIZE: 0.5"
    snowSpeedLabel.Text = "SNOW SPEED: 1.0"
    brightnessLabel.Text = "BRIGHTNESS: 3.0"
    exposureLabel.Text = "EXPOSURE: 0.0"
    saturationLabel.Text = "SATURATION: 0.0"
    contrastLabel.Text = "CONTRAST: 0.0"
    fogLabel.Text = "FOG DENSITY: 0.0"
    sunLabel.Text = "SUN INTENSITY: 1.0"
    ambientLabel.Text = "AMBIENT WARMTH: 0.5"
    shadowButton.Text = "SHADOWS: ON"
end)

