-- ============================================
-- 検知されないアンチBan（自動で逃げない）
-- ============================================
local function setupAntiBan()
    -- 絶対にKickさせない（それだけのシンプルで安全な仕様）
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if method == "Kick" then
            return nil
        end
        return oldNamecall(self, ...)
    end))
end

